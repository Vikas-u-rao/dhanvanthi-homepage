datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String
  project   String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
